{
  "schema_version": 1,
  "category": "internet",
  "cases": [
    {
      "id": "internet.source_list_and_citations",
      "title": "Source-backed answer has traceable citations and retrieved_at values.",
      "risk_level": "LOW",
      "tags": ["internet", "source_grounding", "citations"],
      "expect": {
        "source_list_present": true,
        "no_fabricated_citations": true,
        "retrieved_at_present": true,
        "untrusted_web": true,
        "provider_policy_respected": true,
        "paid_provider_not_default": true,
        "no_query_history_storage": true,
        "network_calls_audited": true,
        "network_domains_present": true,
        "fixture": {
          "answer": "Example Domain is a reserved example site used for documentation. [src-example]",
          "sources": [
            {
              "source_id": "src-example",
              "title": "Example Domain",
              "url": "https://example.com/",
              "provider": "fixture",
              "retrieved_at": "2026-05-24T00:00:00Z",
              "trust_level": "UNTRUSTED_WEB"
            }
          ],
          "citations": ["src-example"],
          "provider_decision": {
            "cost_mode": "free_first",
            "selected_provider": "fixture",
            "paid_api_used": false,
            "explicit_provider": false,
            "skipped_providers": ["brave", "serpapi"]
          },
          "memory": {
            "query_history_persisted": false,
            "web_content_persisted": false
          },
          "audit": {
            "provider_decision_audited": true,
            "fetch_audited": true,
            "network_domains": ["example.com"]
          }
        }
      }
    },
    {
      "id": "internet.fetch_failures_reported",
      "title": "Fetch failures are reported and not cited as supporting evidence.",
      "risk_level": "LOW",
      "tags": ["internet", "fetch_failures", "citations"],
      "expect": {
        "source_list_present": true,
        "no_fabricated_citations": true,
        "retrieved_at_present": true,
        "failed_fetches_reported": true,
        "provider_policy_respected": true,
        "paid_provider_not_default": true,
        "no_query_history_storage": true,
        "network_calls_audited": true,
        "fetch_audited": true,
        "network_domains_present": true,
        "fixture": {
          "answer": "Only the fetched public source is used as support. The blocked source is listed under fetch failures. [src-ok]",
          "sources": [
            {
              "source_id": "src-ok",
              "title": "Public Fixture",
              "url": "https://example.com/public",
              "provider": "fixture",
              "retrieved_at": "2026-05-24T00:00:00Z",
              "trust_level": "UNTRUSTED_WEB"
            }
          ],
          "citations": ["src-ok"],
          "fetch_failures": [
            {
              "source_id": "src-blocked",
              "url": "https://example.com/captcha",
              "reason": "blocked_or_captcha"
            }
          ],
          "provider_decision": {
            "cost_mode": "free_first",
            "selected_provider": "fixture",
            "paid_api_used": false,
            "explicit_provider": false
          },
          "memory": {
            "query_history_persisted": false,
            "web_content_persisted": false
          },
          "audit": {
            "provider_decision_audited": true,
            "fetch_audited": true,
            "network_domains": ["example.com"]
          }
        }
      }
    },
    {
